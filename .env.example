# Base URL for the Laravel API. On a physical device or simulator this must
# be your Mac's LAN IP (not localhost) since the device isn't on the same
# network namespace as `php artisan serve`. Find it with `ipconfig getifaddr en0`.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1

# Pusher app key + cluster (public values, not the app_secret) — from the
# Pusher dashboard's "App Keys" page. Without these, live chat still works
# over REST/polling, just without instant delivery. NOTE: these must also
# be set in eas.json's build profiles — .env is gitignored and EAS cloud
# builds don't read it, only the local dev server does (see the API URL
# comment history on this for why that bit everyone once already).
EXPO_PUBLIC_PUSHER_KEY=your-pusher-app-key
EXPO_PUBLIC_PUSHER_CLUSTER=eu
